# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare wrangler auto-generated env types — kept at the repo root by
# `wrangler types`, but the worker's own tsconfig is the source of truth
# for worker-side types. Keeping this out of git avoids it leaking into
# the Next.js type-check pass (it pins env vars to literal URLs).
worker-configuration.d.ts
